{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ImageStorage": {
    "RootPath": "App_Data/images",
    "RequestPath": "/uploads",
    "MaxBytes": 10485760
  },
  "DocumentStorage": {
    "RootPath": "App_Data/documents",
    "MaxBytes": 52428800
  }
}
